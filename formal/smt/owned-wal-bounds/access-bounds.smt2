; Bounded unsafe WAL accesses; input/domain facts from owned_statement.clj and owned_ascii_wal.ss.
(set-logic QF_LIA)
(declare-const n Int)
(declare-const i Int)
(declare-const at Int)
(declare-const total Int)
(declare-const cp Int)
(declare-const capacity Int)
(declare-const reservation Int)
(declare-const kind Int)
(declare-const offset Int)
(declare-const escape Int)
(declare-const width Int)
(declare-const index Int)
(declare-const length Int)
(declare-const digit Int)
(declare-const byte_value Int)
(declare-const violation Bool)
(assert (! (and (<= 0 n) (<= n 67108864)) :named snapshot_size))
(assert (! (= capacity (ite (< (+ n 11) 256) 256 (ite (> (+ n 11) 65536) 65536 (+ n 11)))) :named allocated_capacity))
(assert (! (and (<= 0 i) (<= i n) (<= 0 at) (<= at capacity) (<= 0 total) (<= (+ total at) (+ 8 (* 6 i)))) :named inductive_loop_domain))
(assert (! (and (<= 0 cp) (<= cp 127)) :named trusted_private_ascii))
(assert (! (= escape (ite (or (= cp 34) (= cp 92) (= cp 47)) cp
                     (ite (= cp 8) 98 (ite (= cp 12) 102 (ite (= cp 10) 110 (ite (= cp 13) 114 (ite (= cp 9) 116 (ite (< cp 32) 1 0)))))))) :named exact_escape_table))
(assert (! (= width (ite (= escape 0) 1 (ite (= escape 1) 6 2))) :named emitted_width))
(assert (! (and (<= 0 kind) (<= kind 2)) :named access_kinds))
(assert (! (and (< i n) (<= at (- capacity reservation))) :named source_body_guards))
(assert (! (and (<= 0 offset) (< offset width)) :named concrete_write_offset))
(assert (! (= index (ite (= kind 0) i (ite (= kind 1) cp (+ at offset)))) :named concrete_index))
(assert (! (= length (ite (= kind 0) n (ite (= kind 1) 128 capacity))) :named backing_length))
(assert (! (= digit (ite (= offset 2) (mod (div cp 4096) 16) (ite (= offset 3) (mod (div cp 256) 16) (ite (= offset 4) (mod (div cp 16) 16) (mod cp 16))))) :named hexadecimal_digit))
(assert (! (= byte_value (ite (= escape 0) cp
                     (ite (= escape 1)
                       (ite (= offset 0) 92 (ite (= offset 1) 117 (ite (< digit 10) (+ 48 digit) (+ 87 digit))))
                       (ite (= offset 0) 92 escape)))) :named concrete_written_byte))
(assert (! (= violation (or (< index 0) (>= index length)
                      (and (= kind 2) (or (< byte_value 0) (> byte_value 255))))) :named queried_violation))
(assert (! (= reservation 12) :named current_guard_reservation))
(assert (! violation :named counterexample))
