diff --git a/resources/jdbc/chdb/byte_prefix_copy.ss b/resources/jdbc/chdb/byte_prefix_copy.ss
new file mode 100644
index 0000000..2da3281
--- /dev/null
+++ b/resources/jdbc/chdb/byte_prefix_copy.ss
@@ -0,0 +1,19 @@
+;; Synchronous copy only. No managed address, owner or borrowed view escapes.
+;; Stock ffi/write-array currently copies into a temporary bytevector first.
+;; Reuse its SAME non-collect-safe adapter, but pass the existing byte backing.
+(if (and (top-level-bound? 'sa-foreign-bytes-set!)
+         (procedure? (top-level-value 'sa-foreign-bytes-set!))
+         (bitwise-bit-set? (procedure-arity-mask (top-level-value 'sa-foreign-bytes-set!)) 3))
+    (let ((copy! (top-level-value 'sa-foreign-bytes-set!)))
+      (lambda (pointer bytes n)
+        (and (jolt-array? bytes)
+             (eq? (record-type-uid (record-rtd bytes)) 'jolt-array-v1)
+             (eq? (jolt-array-kind bytes) 'byte)
+             (bytevector? (jolt-array-vec bytes))
+             (let ((backing (jolt-array-vec bytes)) (n (jnum->exact n)))
+               (unless (and (fixnum? n) (fx>=? n 0)
+                            (fx<=? n (bytevector-length backing)))
+                 (error 'byte-prefix-copy "invalid byte range"))
+               (unless (fx=? n 0) (copy! (jnum->exact pointer) backing n))
+               n))))
+    (lambda (pointer bytes n) #f))
diff --git a/src/jdbc/chdb/byte_copy.clj b/src/jdbc/chdb/byte_copy.clj
new file mode 100644
index 0000000..0d9d3a2
--- /dev/null
+++ b/src/jdbc/chdb/byte_copy.clj
@@ -0,0 +1,25 @@
+(ns jdbc.chdb.byte-copy
+  "Internal synchronous byte-prefix copies into caller-owned foreign storage."
+  (:require [clojure.java.io :as io] [jolt.scheme :as scheme] [jolt.ffi :as ffi]))
+
+(defmacro ^:private kernel-source []
+  (if-let [resource (io/resource "jdbc/chdb/byte_prefix_copy.ss")]
+    (slurp resource)
+    (throw (ex-info "Missing byte-copy resource" {}))))
+(def ^:private source (kernel-source))
+(def ^:private prefix-copy
+  ;; An unavailable private runtime adapter keeps the ordinary FFI path.
+  ;; Catch only loading/qualification, NEVER a copy that may already have run.
+  (delay (try (scheme/eval-string source) (catch Throwable _ (fn [& _] false)))))
+
+(defn write-prefix!
+  "Copy bytes[0,length) into valid caller-owned foreign storage. Return length.
+  No destination allocation/lifetime checks or source ownership transfer are
+  implied. Source must not race with this call. Unsupported runtime/backing
+  uses ordinary ffi/write-array."
+  [pointer bytes length]
+  (when-not (and (bytes? bytes) (integer? length) (<= 0 length (alength bytes)))
+    (throw (ex-info "Invalid byte-copy range" {:type ::invalid-range})))
+  (if (zero? length) 0
+    (let [result (@prefix-copy pointer bytes length)]
+      (if (false? result) (ffi/write-array pointer bytes 0 length) result))))
