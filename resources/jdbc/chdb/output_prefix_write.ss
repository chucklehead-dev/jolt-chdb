;; Borrow bytes only for this synchronous builtin-port write. No flush/close.
;; Decline extended stream states (pipes/wrappers) before touching their port.
(if (and
     ;; Record predicates/accessors are lexical syntax, not top-level procedures.
     (eq? (record-type-uid (record-type-descriptor jhost)) 'chez-jhost-v1)
     (equal? (record-type-field-names (record-type-descriptor jhost)) '#(tag state))
     (eq? (record-type-uid (record-type-descriptor jolt-array)) 'jolt-array-v1)
     (equal? (record-type-field-names (record-type-descriptor jolt-array)) '#(vec kind))
     (for-all
      (lambda (entry)
        (and (top-level-bound? (car entry))
             (procedure? (top-level-value (car entry)))
             (bitwise-bit-set? (procedure-arity-mask (top-level-value (car entry))) (cadr entry))))
      '((out-stream-live-port 1) (jnum->exact 1))))
    (lambda (output bytes count)
      (and (jhost? output)
           (eq? (record-type-uid (record-rtd output)) 'chez-jhost-v1)
           (string=? (jhost-tag output) "out-stream")
           (vector? (jhost-state output))
           (fx=? (vector-length (jhost-state output)) 3)
           (not (vector-ref (jhost-state output) 1))
           (not (vector-ref (jhost-state output) 2))
           (port? (vector-ref (jhost-state output) 0))
           (file-port? (vector-ref (jhost-state output) 0))
           (binary-port? (vector-ref (jhost-state output) 0))
           (output-port? (vector-ref (jhost-state output) 0))
           (jolt-array? bytes)
           (eq? (record-type-uid (record-rtd bytes)) 'jolt-array-v1)
           (eq? (jolt-array-kind bytes) 'byte)
           (bytevector? (jolt-array-vec bytes))
           (let ((n (jnum->exact count)) (backing (jolt-array-vec bytes)))
             (and (fixnum? n) (fx>=? n 0) (fx<=? n (bytevector-length backing))
                  (let ((port (out-stream-live-port output)))
                    (put-bytevector port backing 0 n)
                    #t)))))
    (lambda (output bytes count) #f))
