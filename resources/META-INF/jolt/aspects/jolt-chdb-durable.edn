{:schema 1
 :library {:id io.github.chucklehead-dev/jolt-chdb
           :version "4a0b82119a09fdadb08442cb5d189bdc0474ed86"}
 :aspects
 [{:id :durable/acquire
   :match {:entry jdbc.chdb.durable.control/acquire! :arity 2}
   :advice-role :durable/control
   :expect {:matches 1}}
  {:id :durable/publish-wal
   :match {:entry jdbc.chdb.durable.control/publish-wal-bytes! :arity 4}
   :advice-role :durable/control
   :expect {:matches 1}}
  {:id :durable/publish-checkpoint
   :match {:entry jdbc.chdb.durable.control/publish-checkpoint-file! :arity 4}
   :advice-role :durable/control
   :expect {:matches 1}}
  {:id :durable/commit-reference
   :match {:entry jdbc.chdb.durable.control/commit-reference! :arity 3}
   :advice-role :durable/control
   :expect {:matches 1}}
  {:id :durable/renew
   :match {:entry jdbc.chdb.durable.control/renew! :arity 4}
   :advice-role :durable/control
   :expect {:matches 1}}
  {:id :durable/release
   :match {:entry jdbc.chdb.durable.control/release! :arity 3}
   :advice-role :durable/control
   :expect {:matches 1}}]}
