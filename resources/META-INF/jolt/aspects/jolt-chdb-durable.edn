{:schema 1
 :library {:id io.github.chucklehead-dev/jolt-chdb
           :version "edc86af07d5982a185c4ef953c19c848a719da0e"}
 :aspects
 [{:id :durable/acquire
   :match {:entry jdbc.chdb.durable.control/acquire! :arity 2}
   :advice-role :durable/control
   :expect {:matches 1}}
  {:id :durable/publish-wal
   :match {:entry jdbc.chdb.durable.control/publish-wal-bytes! :arity 3}
   :advice-role :durable/control
   :expect {:matches 1}}
  {:id :durable/publish-checkpoint
   :match {:entry jdbc.chdb.durable.control/publish-checkpoint-file! :arity 3}
   :advice-role :durable/control
   :expect {:matches 1}}
  {:id :durable/commit-reference
   :match {:entry jdbc.chdb.durable.control/commit-reference! :arity 3}
   :advice-role :durable/control
   :expect {:matches 1}}
  {:id :durable/renew
   :match {:entry jdbc.chdb.durable.control/renew! :arity 3}
   :advice-role :durable/control
   :expect {:matches 1}}
  {:id :durable/release
   :match {:entry jdbc.chdb.durable.control/release! :arity 2}
   :advice-role :durable/control
   :expect {:matches 1}}]}
