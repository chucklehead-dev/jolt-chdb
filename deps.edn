{:paths ["src" "resources"]
 :jolt/min-version "0.8.3"
 :deps {io.github.casselc/db
        {:git/url "https://github.com/casselc/db.git"
         :git/sha "a5bf25d9e141e8dcf28d6d07cd053fceb0019563"}
        org.clojure/data.json
        {:git/url "https://github.com/casselc/data.json.git"
         :git/sha "932444043c0c06f9e295ba4963419b2481e9dd07"}
        com.github.seancorfield/honeysql
        {:git/url "https://github.com/seancorfield/honeysql.git"
         :git/sha "308d5a741825cb13ded6d4766041306a61181acb"}}
 :aliases {:setup-native {:main-opts ["-m" "jdbc.chdb.install"]}
           :abi-test {:extra-paths ["test"]
                      :main-opts ["-m" "jdbc.chdb-abi-test"]}
           :durable-head-test
           {:extra-deps
            {io.github.chucklehead-dev/jolt-hegel
             {:git/url "https://github.com/chucklehead-dev/jolt-hegel.git"
              :git/sha "b214f769983211431c74e427f0f35553cfba7b34"}}
            :extra-paths ["test"]
            :main-opts ["-m" "jdbc.chdb-durable-head-test"]}
           :test {:extra-deps
                  {io.github.chucklehead-dev/jolt-hegel
                   {:git/url "https://github.com/chucklehead-dev/jolt-hegel.git"
                    :git/sha "b214f769983211431c74e427f0f35553cfba7b34"}}
                  :extra-paths ["test"]
                  :main-opts ["-m" "jdbc.chdb-test"]}}
 :tasks {setup-native "jolt -M:setup-native"
         abi-test "jolt -M:abi-test"
         durable-head-test "jolt -M:durable-head-test"
         test "jolt -M:test"
         test-threadstatus "bash test/encoded-threadstatus.sh"}}
